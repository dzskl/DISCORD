# =====================================================
# BotDash — variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# =====================================================

# ---- Servidor ----
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-longa
# Quando atras de Nginx/Cloudflare deixe em 1 para confiar no X-Forwarded-*
TRUST_PROXY=0
LOG_LEVEL=info

# ---- Discord Bot ----
# Crie em https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID do servidor onde o bot atua
DISCORD_GUILD_ID=
# IDs Discord (separados por virgula) que podem logar como admin no dashboard.
# Deixe vazio para permitir somente o owner do servidor.
ADMIN_DISCORD_IDS=

# ---- Stripe (opcional - gateway internacional) ----
# Crie em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret obtido com `stripe listen` ou no painel de webhooks
STRIPE_WEBHOOK_SECRET=
# Moeda usada nos checkouts (brl, usd, eur...)
STRIPE_CURRENCY=brl
# Metodos de pagamento separados por virgula: card,pix,boleto
STRIPE_PAYMENT_METHODS=card,pix

# ---- MisticPay (opcional - gateway PIX nacional) ----
# Crie em https://misticpay.com - taxa menor, PIX nativo
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=

# ---- Banco ----
DATABASE_FILE=./data/botdash.sqlite

# ---- Modo desenvolvimento ----
# Pule o login do Discord e acesse o dashboard direto.
# IGNORADO automaticamente quando NODE_ENV=production.
DEV_BYPASS_AUTH=0
